# Local-only development configuration. Replace all values in a real deployment.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DATABASE_URL=postgresql://chamados:chamados-local-only@db:5432/chamados
POSTGRES_DB=chamados
POSTGRES_USER=chamados
POSTGRES_PASSWORD=chamados-local-only
# CHM-402: Example values above are development-only; NEVER reuse them in production.
# In production: DJANGO_DEBUG=false, random DJANGO_SECRET_KEY (50+ chars),
# explicit DJANGO_ALLOWED_HOSTS, persistent PostgreSQL DATABASE_URL and HTTPS redirect.
# Set DJANGO_TRUST_PROXY_SSL_HEADER=true ONLY behind a trusted sanitizing TLS proxy.
# DJANGO_TRUST_PROXY_SSL_HEADER=false

# CHM-501: the Redis container is for local development only; do not publish port 6379.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CHM-601: only enable after HTTPS and domain/proxy checks in production.
# DJANGO_HSTS_SECONDS=0
# In deployment, configure DJANGO_TRUST_PROXY_SSL_HEADER only behind a trusted proxy.
