# Local-only development configuration. Replace all values in a real deployment.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DATABASE_URL=postgresql://chamados:chamados@db:5432/chamados
POSTGRES_DB=chamados
POSTGRES_USER=chamados
POSTGRES_PASSWORD=chamados-local-only
