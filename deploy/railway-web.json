{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "python manage.py migrate --noinput",
    "healthcheckPath": "/api/health/ready/",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ALWAYS"
  }
}
