            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Demonstração de API\",\n  \"description\": \"Chamado sintético: nenhuma informação pessoal real.\",\n  \"category\": \"suporte\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201 e referencia',()=>{pm.response.to.have.status(201);pm.expect(pm.response.json().reference).to.match(/^CH-/);});if(pm.response.code===201){pm.collectionVariables.set('ticketId',String(pm.response.json().id));pm.collectionVariables.set('ticketReference',pm.response.json().reference);}"
                ]
              }
            }
          ]
        },
