                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{requesterUsername}}\",\n  \"password\": \"{{requesterPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JWT access presente',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().access).to.be.a('string');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Meu perfil solicitante",
